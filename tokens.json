{
  "$schema": "Calmido design-system tokens — source of truth. tokens.css is generated from this file via scripts/build-tokens.mjs.",
  "$prefixes": {
    "color":    "--c-",
    "font-ink": "--c-font-",
    "theme":    "--c-",
    "font":     "--font-",
    "spacing":  "--sp-",
    "radius":   "--r-"
  },
  "color": [
    { "comment": "Calmido colour tokens (exact values from CSS styles frame)" },
    { "name": "blue",          "value": "#07369E", "note": "Calmido Blue — headlines, primary ink on light" },
    { "name": "bright-blue",   "value": "#2050FF", "note": "action accent, links" },
    { "name": "dark-blue",     "value": "#081748", "note": "primary ink on light, dark surfaces" },
    { "name": "logo-blue",     "value": "#05028E", "note": "canonical brand blue — logo art only" },
    { "name": "body-ink",      "value": "#3A4268", "note": "body prose on light" },
    { "name": "dark-green",    "value": "#10C186", "note": "fills only — 2.33:1 on white, never text" },
    { "name": "green-ink",     "value": "#0A7A55", "note": "green text, icons and links on light — 5.35:1 on white" },
    { "name": "bright-green",  "value": "#40EDAB", "note": "accent / filled-button bg" },
    { "name": "tonal-green",   "value": "#DBF6ED", "note": "tonal button bg" },
    { "name": "bg-dark",       "value": "#202128" },
    { "name": "infocard-dark", "value": "#16171C" },
    { "name": "mid-grey",      "value": "#C1C3EB" },
    { "name": "dark-grey",     "value": "#6F797A", "note": "outlined border / secondary ink" },
    { "name": "light-grey",    "value": "#DADBE0" },
    { "name": "light-bg",      "value": "#FBFBFB" },
    { "name": "white",         "value": "#FFFFFF" },
    { "name": "stop-red",      "value": "#FF3260" },
    { "name": "alert-red",     "value": "#FD5240" },
    { "name": "dark-red",      "value": "#690005" },

    { "comment": "threat scale, low to high. Named for the band, not the hue — the bands are the same score thresholds on all three clients." },
    { "name": "threat-safe",      "value": "{color.dark-green}" },
    { "name": "threat-caution",   "value": "#9ACD32", "note": "between safe and elevated" },
    { "name": "threat-elevated",  "value": "#F5A623", "note": "elevated / amber" },
    { "name": "threat-dangerous", "value": "{color.stop-red}" },
    { "name": "threat-unrated",   "value": "{color.mid-grey}", "note": "no score yet — off the scale rather than on it" },

    { "comment": "threat inks: the bright hues above are fills (meter, badges, arcs); text and icons on light use these" },
    { "name": "threat-dangerous-ink", "value": "#D0103A", "note": "5.5:1 on white" },
    { "name": "threat-elevated-ink",  "value": "#8A5300", "note": "6.3:1 on white" },

    { "comment": "caller-card gradients: white ink stays ≥ 4.5:1 along the whole gradient" },
    { "name": "caller-warning-start", "value": "#B45309", "note": "5.0:1 with white" },
    { "name": "caller-warning-end",   "value": "#DF1803", "note": "4.9:1 with white" },
    { "name": "caller-alert-start",   "value": "#D0103A", "note": "5.5:1 with white; alert-red was 3.25:1" },
    { "name": "caller-alert-end",     "value": "#C91300", "note": "5.9:1 with white" },

    { "comment": "neutrals observed in canvas (f7f7f8 base, 242 238 237 warm)" },
    { "name": "canvas",        "value": "#F7F7F8" },
    { "name": "canvas-warm",   "value": "#F2EEED" }
  ],
  "font-ink": [
    { "comment": "Re-points to brand colours. Add class=\"inverse\" on a parent to flip all three tokens to their inverse pairs (e.g. on dark surfaces). The dark theme uses the inverse pairs." },
    { "name": "title",          "value": "{color.blue}",      "dark": "{font-ink.title-inverse}" },
    { "name": "title-inverse",  "value": "{color.white}" },
    { "name": "body",           "value": "{color.dark-blue}", "dark": "{font-ink.body-inverse}" },
    { "name": "body-inverse",   "value": "#FFFFFFBF", "note": "white @ 75%" },
    { "name": "muted",          "value": "{color.dark-grey}", "dark": "{font-ink.muted-inverse}" },
    { "name": "muted-inverse",  "value": "#FFFFFF99", "note": "white @ 60%" }
  ],
  "theme": [
    { "comment": "Theme roles: \"value\" is light, \"dark\" is dark. Components use these, not palette names, so they follow the theme." },
    { "name": "surface",        "value": "{color.light-bg}",             "dark": "{color.bg-dark}",        "note": "page background" },
    { "name": "surface-raised", "value": "{color.white}",                "dark": "{color.infocard-dark}",  "note": "cards, panels" },
    { "name": "surface-muted",  "value": "{color.light-grey}",           "dark": "#2E2F38",                "note": "filled chips, tracks" },
    { "name": "border",         "value": "{color.light-grey}",           "dark": "#3A3B45",                "note": "dividers, card edges" },
    { "name": "border-strong",  "value": "{color.dark-grey}",            "dark": "#80838C",                "note": "input borders — ≥ 3:1 on the surface" },
    { "name": "ink-link",       "value": "{color.blue}",                 "dark": "#7DA2FF",                "note": "6.5:1 on bg-dark" },
    { "name": "ink-green",      "value": "{color.green-ink}",            "dark": "{color.bright-green}",   "note": "green text and icons" },
    { "name": "ink-danger",     "value": "{color.threat-dangerous-ink}", "dark": "#FF6B87",                "note": "dangerous verdict, errors — 5.9:1 on bg-dark" },
    { "name": "ink-warning",    "value": "{color.threat-elevated-ink}",  "dark": "{color.threat-elevated}", "note": "suspicious verdict — 7.9:1 on bg-dark" },
    { "name": "focus-ring",     "value": "{color.dark-blue}",            "dark": "{color.white}",          "note": "2px outline" },
    { "name": "focus-halo",     "value": "{color.white}",                "dark": "{color.dark-blue}",      "note": "2px halo inside the ring" }
  ],
  "font": [
    { "comment": "Font families — three free / Google Fonts" },
    { "name": "display", "value": "\"Geologica\", system-ui, -apple-system, Segoe UI, sans-serif" },
    { "name": "body",    "value": "\"Open Sans\",  system-ui, -apple-system, Segoe UI, sans-serif" },
    { "name": "mono",    "value": "\"Courier Prime\", ui-monospace, Menlo, monospace" }
  ],
  "spacing": [
    { "comment": "Spacing scale — multiples of 4px" },
    { "name": "1",  "value": "4px"  },
    { "name": "2",  "value": "8px"  },
    { "name": "3",  "value": "12px" },
    { "name": "4",  "value": "16px" },
    { "name": "5",  "value": "20px" },
    { "name": "6",  "value": "24px" },
    { "name": "8",  "value": "32px" },
    { "name": "10", "value": "40px" },
    { "name": "12", "value": "48px" },
    { "name": "16", "value": "64px" },
    { "name": "20", "value": "80px" },
    { "name": "24", "value": "96px" }
  ],
  "radius": [
    { "comment": "Radii observed: 4 (input), 16 (card), 20 (pill input), 30 (avatar btn), 100 (button/switch)" },
    { "name": "sm",   "value": "4px"   },
    { "name": "md",   "value": "12px"  },
    { "name": "lg",   "value": "16px"  },
    { "name": "pill", "value": "100px" }
  ]
}
